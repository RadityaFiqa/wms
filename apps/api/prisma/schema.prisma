generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                        Int                   @id @default(autoincrement())
  uuid                      String                @unique @default(uuid())
  email                     String                @unique
  password                  String
  name                      String
  isActive                  Boolean               @default(true)
  isFirstLogin              Boolean               @default(true)
  roleId                    Int
  warehouseId               Int?
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt
  auditLogsActor            AuditLog[]            @relation("ActorRelation")
  auditLogsTarget           AuditLog[]            @relation("TargetRelation")
  uploadedFiles             FileAttachment[]
  gateOperationsCreated     GateOperation[]       @relation("GateOpCreator")
  gateVerificationsVerified GateVerification[]    @relation("GateVerifier")
  orders                    Order[]
  passwordResetTokens       PasswordResetToken[]
  sessions                  Session[]
  role                      Role                  @relation(fields: [roleId], references: [id])
  warehouse                 Warehouse?            @relation(fields: [warehouseId], references: [id])
  warehouseAccesses         WarehouseAccess[]

  @@index([email])
  @@index([uuid])
}

model Role {
  id          Int              @id @default(autoincrement())
  uuid        String           @unique @default(uuid())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  users       User[]

  @@index([uuid])
  @@index([name])
}

model Permission {
  id         Int              @id @default(autoincrement())
  uuid       String           @unique @default(uuid())
  action     String
  subject    String
  conditions String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  roles      RolePermission[]

  @@index([uuid])
}

model RolePermission {
  roleId       Int
  permissionId Int
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Session {
  id        Int      @id @default(autoincrement())
  uuid      String   @unique @default(uuid())
  userId    Int
  token     String   @unique
  userAgent String?
  ipAddress String?
  isRevoked Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([uuid])
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  uuid      String   @unique @default(uuid())
  userId    Int
  token     String   @unique
  isUsed    Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([uuid])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  uuid      String   @unique @default(uuid())
  actorId   Int?
  targetId  Int?
  action    String
  ipAddress String?
  userAgent String?
  details   String?
  timestamp DateTime @default(now())
  actor     User?    @relation("ActorRelation", fields: [actorId], references: [id])
  target    User?    @relation("TargetRelation", fields: [targetId], references: [id])

  @@index([actorId])
  @@index([targetId])
  @@index([action])
  @@index([uuid])
}

model Warehouse {
  id                 Int                  @id @default(autoincrement())
  uuid               String               @unique @default(uuid())
  code               String               @unique @default("TEMP")
  name               String
  location           String
  capacity           Float
  type               String?
  address            String?
  isActive           Boolean              @default(true)
  odooReference      String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  gateOperations     GateOperation[]
  inventories        Inventory[]
  locations          Location[]
  odooAccount        OdooAccount?
  users              User[]
  warehouseAccesses  WarehouseAccess[]
  documentReferences DocumentReference[]
  odooSyncLogs       OdooSyncLog[]

  @@index([uuid])
  @@index([code])
}

model OdooAccount {
  id                Int       @id @default(autoincrement())
  uuid              String    @unique @default(uuid())
  warehouseId       Int       @unique
  baseUrl           String
  username          String
  encryptedPassword String
  sessionId         String?
  csrfToken         String?
  sessionExpiredAt  DateTime?
  lastLoginAt       DateTime?
  lastRefreshAt     DateTime?
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  lastSyncAt        DateTime?
  lastSyncBy        String?
  lastSyncCount     Int?
  lastSyncError     String?
  lastSyncStatus    String?
  warehouse         Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@index([warehouseId])
  @@index([uuid])
}

model Product {
  id                       Int                       @id
  uuid                     String                    @unique @default(uuid())
  sku                      String                    @unique
  name                     String
  description              String?
  category                 String
  price                    Float
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  uom                      String?
  gateOperationProducts    GateOperationProduct[]
  gateVerificationProducts GateVerificationProduct[]
  inventories              Inventory[]
  orderItems               OrderItem[]
  quants                   Quant[]

  @@index([uuid])
  @@index([sku])
}

model Location {
  id             Int       @id
  uuid           String    @unique @default(uuid())
  displayName    String
  warehouseId    Int
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  warehouse      Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  quants         Quant[]

  @@index([warehouseId])
}

model Quant {
  id                Int      @id
  uuid              String   @unique @default(uuid())
  productId         Int
  locationId        Int
  quantity          Float    @default(0)
  reservedQuantity  Float    @default(0)
  availableQuantity Float    @default(0)
  secondaryUnitQty  Float?   @default(0)
  lotName           String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  location          Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([locationId])
}

model Inventory {
  id          Int       @id @default(autoincrement())
  uuid        String    @unique @default(uuid())
  warehouseId Int
  productId   Int
  quantity    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, productId])
  @@index([uuid])
}

model Order {
  id         Int         @id @default(autoincrement())
  uuid       String      @unique @default(uuid())
  status     OrderStatus @default(PENDING)
  userId     Int
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([userId])
  @@index([uuid])
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  uuid      String  @unique @default(uuid())
  orderId   Int
  productId Int
  quantity  Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([uuid])
}

model WarehouseAccess {
  userId      Int
  warehouseId Int
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@id([userId, warehouseId])
}

model FileAttachment {
  id                 Int               @id @default(autoincrement())
  uuid               String            @unique @default(uuid())
  filePath           String
  fileName           String
  mimeType           String
  sizeBytes          Int
  uploadedById       Int
  uploadedAt         DateTime          @default(now())
  uploadedBy         User              @relation(fields: [uploadedById], references: [id])
  gateOperationId    Int?
  gateVerificationId Int?
  gateOperation      GateOperation?    @relation(fields: [gateOperationId], references: [id], onDelete: Cascade)
  gateVerification   GateVerification? @relation(fields: [gateVerificationId], references: [id], onDelete: Cascade)
}

model GateOperation {
  id              Int                    @id @default(autoincrement())
  uuid            String                 @unique @default(uuid())
  opNumber        String                 @unique
  cardType        CardType
  driverName      String
  licensePlate    String
  notes           String?
  status          VerificationStatus     @default(PENDING)
  warehouseId     Int
  createdByUserId Int
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  createdByUser   User                   @relation("GateOpCreator", fields: [createdByUserId], references: [id])
  warehouse       Warehouse              @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  products        GateOperationProduct[]
  verification    GateVerification?
  poReferences    String[]               @default([])
  soReferences    String[]               @default([])
  attachments     FileAttachment[]

  @@index([uuid])
  @@index([opNumber])
  @@index([warehouseId])
  @@index([status])
}

model GateOperationProduct {
  id              Int                      @id @default(autoincrement())
  uuid            String                   @unique @default(uuid())
  gateOperationId Int
  productId       Int
  quantity        Float
  notes           String?
  gateOperation   GateOperation            @relation(fields: [gateOperationId], references: [id], onDelete: Cascade)
  product         Product                  @relation(fields: [productId], references: [id])
  references      GateDocumentReference[]

  @@index([gateOperationId])
  @@index([productId])
}

model GateVerification {
  id              Int                       @id @default(autoincrement())
  uuid            String                    @unique @default(uuid())
  gateOperationId Int                       @unique
  verifiedById    Int
  verifiedAt      DateTime                  @default(now())
  status          VerificationStatus        @default(PENDING)
  notes           String?
  gateOperation   GateOperation             @relation(fields: [gateOperationId], references: [id], onDelete: Cascade)
  verifiedBy      User                      @relation("GateVerifier", fields: [verifiedById], references: [id])
  products        GateVerificationProduct[]
  attachments     FileAttachment[]
  references      GateDocumentReference[]

  @@index([uuid])
  @@index([gateOperationId])
}

model GateVerificationProduct {
  id                 Int              @id @default(autoincrement())
  uuid               String           @unique @default(uuid())
  gateVerificationId Int
  productId          Int
  quantity           Float
  gateVerification   GateVerification @relation(fields: [gateVerificationId], references: [id], onDelete: Cascade)
  product            Product          @relation(fields: [productId], references: [id])

  @@index([gateVerificationId])
  @@index([productId])
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum CardType {
  IN
  OUT
}

enum VerificationStatus {
  PENDING
  PARTIAL
  COMPLETED
  CANCELED
  VERIFIED
  REJECTED
}

model DocumentReference {
  id                        Int                      @id
  uuid                      String                   @unique @default(uuid())
  warehouseId               Int
  documentNumber            String
  state                     String
  pickingTypeCode           String
  partnerName               String?
  purchaseName              String?
  origin                    String?
  sourceLocationName        String?
  destinationLocationName   String?
  scheduledDate             DateTime?
  dateDone                  DateTime?
  driver                    String?
  plateNumber               String?
  totalItems                Int
  totalQuantity             Float
  rawPayload                Json
  lastSyncedAt              DateTime                 @default(now())
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt
  warehouse                 Warehouse                @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  items                     DocumentReferenceItem[]
  references                GateDocumentReference[]

  @@index([warehouseId])
  @@index([uuid])
  @@index([documentNumber])
}

model DocumentReferenceItem {
  id                  Int                      @id
  uuid                String                   @unique @default(uuid())
  documentReferenceId Int
  productId           Int
  productName         String
  uom                 String
  analyticAccountName String?
  quantity            Float
  productQty          Float
  secondaryQuantity   Float?
  secondaryUom        String?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  documentReference   DocumentReference        @relation(fields: [documentReferenceId], references: [id], onDelete: Cascade)
  references          GateDocumentReference[]

  @@index([documentReferenceId])
}

enum OdooSyncStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

model OdooSyncLog {
  id                 Int            @id @default(autoincrement())
  uuid               String         @unique @default(uuid())
  warehouseId        Int
  status             OdooSyncStatus
  startedAt          DateTime       @default(now())
  finishedAt         DateTime?
  totalDocuments     Int            @default(0)
  processedDocuments Int            @default(0)
  errorMessage       String?
  createdBy          String
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  warehouse          Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@index([warehouseId])
  @@index([uuid])
}

model GateDocumentReference {
  id                 Int                   @id @default(autoincrement())
  uuid               String                @unique @default(uuid())
  gateVerificationId Int
  gateItemId         Int
  erpDocumentId      Int
  erpDocumentItemId  Int
  productId          Int
  assignedQuantity   Float
  createdAt          DateTime              @default(now())
  createdBy          String

  gateVerification   GateVerification      @relation(fields: [gateVerificationId], references: [id], onDelete: Cascade)
  gateItem           GateOperationProduct  @relation(fields: [gateItemId], references: [id], onDelete: Cascade)
  erpDocument        DocumentReference     @relation(fields: [erpDocumentId], references: [id], onDelete: Cascade)
  erpDocumentItem    DocumentReferenceItem @relation(fields: [erpDocumentItemId], references: [id], onDelete: Cascade)

  @@index([gateVerificationId])
  @@index([gateItemId])
  @@index([erpDocumentId])
  @@index([erpDocumentItemId])
  @@index([productId])
}
