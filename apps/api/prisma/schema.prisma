generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                        Int                   @id @default(autoincrement())
  uuid                      String                @unique @default(uuid())
  email                     String                @unique
  password                  String
  name                      String
  isActive                  Boolean               @default(true)
  isFirstLogin              Boolean               @default(true)
  roleId                    Int
  warehouseId               Int?
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt
  auditLogsActor            AuditLog[]            @relation("ActorRelation")
  auditLogsTarget           AuditLog[]            @relation("TargetRelation")
  uploadedFiles             FileAttachment[]
  gateOperationsCreated     GateOperation[]       @relation("GateOpCreator")
  gateVerificationsVerified GateVerification[]    @relation("GateVerifier")
  orders                    Order[]
  passwordResetTokens       PasswordResetToken[]
  sessions                  Session[]
  role                      Role                  @relation(fields: [roleId], references: [id])
  warehouse                 Warehouse?            @relation(fields: [warehouseId], references: [id])
  warehouseAccesses         WarehouseAccess[]
  stockOpnames              StockOpname[]
  manualDocuments           ManualDocument[]
  signedDocuments           SignedDocument[]
  signatureAuditLogs        SignatureAuditLog[]
  signatures                UserSignature[]

  @@index([email])
  @@index([uuid])
}

model Role {
  id          Int              @id @default(autoincrement())
  uuid        String           @unique @default(uuid())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  users       User[]

  @@index([uuid])
  @@index([name])
}

model Permission {
  id         Int              @id @default(autoincrement())
  uuid       String           @unique @default(uuid())
  action     String
  subject    String
  conditions String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  roles      RolePermission[]

  @@index([uuid])
}

model RolePermission {
  roleId       Int
  permissionId Int
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Session {
  id        Int      @id @default(autoincrement())
  uuid      String   @unique @default(uuid())
  userId    Int
  token     String   @unique
  userAgent String?
  ipAddress String?
  isRevoked Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([uuid])
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  uuid      String   @unique @default(uuid())
  userId    Int
  token     String   @unique
  isUsed    Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([uuid])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  uuid      String   @unique @default(uuid())
  actorId   Int?
  targetId  Int?
  action    String
  ipAddress String?
  userAgent String?
  details   String?
  timestamp DateTime @default(now())
  actor     User?    @relation("ActorRelation", fields: [actorId], references: [id])
  target    User?    @relation("TargetRelation", fields: [targetId], references: [id])

  @@index([actorId])
  @@index([targetId])
  @@index([action])
  @@index([uuid])
}

model Warehouse {
  id                 Int                  @id @default(autoincrement())
  uuid               String               @unique @default(uuid())
  code               String               @unique @default("TEMP")
  name               String
  location           String
  capacity           Float
  type               String?
  address            String?
  isActive           Boolean              @default(true)
  odooReference      String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  gateOperations     GateOperation[]
  locations          Location[]
  odooAccount        OdooAccount?
  users              User[]
  warehouseAccesses  WarehouseAccess[]
  documentReferences DocumentReference[]
  odooSyncLogs       OdooSyncLog[]
  manualDocuments    ManualDocument[]
  signedDocuments    SignedDocument[]
  stockOpnames       StockOpname[]
  dailyStockSnapshots DailyStockSnapshot[]
  inventories        Inventory[]

  @@index([uuid])
  @@index([code])
}

model OdooAccount {
  id                Int       @id @default(autoincrement())
  uuid              String    @unique @default(uuid())
  warehouseId       Int       @unique
  baseUrl           String
  username          String
  encryptedPassword String
  sessionId         String?
  csrfToken         String?
  sessionExpiredAt  DateTime?
  lastLoginAt       DateTime?
  lastRefreshAt     DateTime?
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  lastSyncAt        DateTime?
  lastSyncBy        String?
  lastSyncCount     Int?
  lastSyncError     String?
  lastSyncStatus    String?
  lastOffset        Int       @default(0)
  warehouse         Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@index([warehouseId])
  @@index([uuid])
}

model Location {
  id             Int       @id
  uuid           String    @unique @default(uuid())
  displayName    String
  warehouseId    Int
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  warehouse      Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  quants         Quant[]
  stockOpnameStacks StockOpnameStack[]
  gateOperationProducts    GateOperationProduct[]
  gateVerificationProducts GateVerificationProduct[]

  @@index([warehouseId])
}

model Quant {
  id                Int       @id
  uuid              String    @unique @default(uuid())
  inventoryId       Int
  locationId        Int
  quantity          Float     @default(0)
  reservedQuantity  Float     @default(0)
  availableQuantity Float     @default(0)
  secondaryUnitQty  Float?    @default(0)
  lotName           String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  location          Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  inventory         Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  gateOperationProducts    GateOperationProduct[]
  gateVerificationProducts GateVerificationProduct[]

  @@index([inventoryId])
  @@index([locationId])
}

model Inventory {
  id                       Int                       @id
  uuid                     String                    @unique @default(uuid())
  sku                      String
  name                     String
  uom                      String?
  warehouseId              Int                       @default(1)
  warehouse                Warehouse                 @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  gateOperationProducts    GateOperationProduct[]
  gateVerificationProducts GateVerificationProduct[]
  orderItems               OrderItem[]
  quants                   Quant[]
  stockOpnameItems         StockOpnameItem[]
  dailyStockSnapshots      DailyStockSnapshot[]

  @@index([uuid])
  @@index([sku])
  @@index([warehouseId])
}

model Order {
  id         Int         @id @default(autoincrement())
  uuid       String      @unique @default(uuid())
  status     OrderStatus @default(PENDING)
  userId     Int
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([userId])
  @@index([uuid])
}

model OrderItem {
  id          Int       @id @default(autoincrement())
  uuid        String    @unique @default(uuid())
  orderId     Int
  inventoryId Int
  quantity    Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@index([uuid])
}

model WarehouseAccess {
  userId      Int
  warehouseId Int
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@id([userId, warehouseId])
}

model FileAttachment {
  id                 Int               @id @default(autoincrement())
  uuid               String            @unique @default(uuid())
  filePath           String
  fileName           String
  mimeType           String
  sizeBytes          Int
  uploadedById       Int
  uploadedAt         DateTime          @default(now())
  uploadedBy         User              @relation(fields: [uploadedById], references: [id])
  gateOperationId    Int?
  gateVerificationId Int?
  stockOpnameId      Int?
  gateOperation      GateOperation?    @relation(fields: [gateOperationId], references: [id], onDelete: Cascade)
  gateVerification   GateVerification? @relation(fields: [gateVerificationId], references: [id], onDelete: Cascade)
  stockOpname        StockOpname?      @relation(fields: [stockOpnameId], references: [id], onDelete: Cascade)
}

model GateOperation {
  id              Int                    @id @default(autoincrement())
  uuid            String                 @unique @default(uuid())
  opNumber        String                 @unique
  cardType        CardType
  driverName      String
  licensePlate    String
  clientPartner   String?
  driverPhone     String?
  notes           String?
  status          VerificationStatus     @default(PENDING)
  warehouseId     Int
  createdByUserId Int
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  createdByUser   User                   @relation("GateOpCreator", fields: [createdByUserId], references: [id])
  warehouse       Warehouse              @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  products        GateOperationProduct[]
  verification    GateVerification?
  poReferences    String[]               @default([])
  soReferences    String[]               @default([])
  documentReferenceId Int?
  documentReference   DocumentReference?     @relation(fields: [documentReferenceId], references: [id], onDelete: SetNull)
  attachments     FileAttachment[]

  @@index([uuid])
  @@index([opNumber])
  @@index([warehouseId])
  @@index([status])
}

model GateOperationProduct {
  id              Int                      @id @default(autoincrement())
  uuid            String                   @unique @default(uuid())
  gateOperationId Int
  inventoryId     Int
  quantity        Float
  notes           String?
  quantId         Int?
  locationId      Int?
  gateOperation   GateOperation            @relation(fields: [gateOperationId], references: [id], onDelete: Cascade)
  inventory       Inventory                @relation(fields: [inventoryId], references: [id])
  quant           Quant?                   @relation(fields: [quantId], references: [id], onDelete: SetNull)
  location        Location?                @relation(fields: [locationId], references: [id], onDelete: SetNull)
  references      GateDocumentReference[]

  @@index([gateOperationId])
  @@index([inventoryId])
  @@index([quantId])
  @@index([locationId])
}

model GateVerification {
  id              Int                       @id @default(autoincrement())
  uuid            String                    @unique @default(uuid())
  gateOperationId Int                       @unique
  verifiedById    Int
  verifiedAt      DateTime                  @default(now())
  status          VerificationStatus        @default(PENDING)
  notes           String?
  gateOperation   GateOperation             @relation(fields: [gateOperationId], references: [id], onDelete: Cascade)
  verifiedBy      User                      @relation("GateVerifier", fields: [verifiedById], references: [id])
  products        GateVerificationProduct[]
  attachments     FileAttachment[]
  references      GateDocumentReference[]

  @@index([uuid])
  @@index([gateOperationId])
}

model GateVerificationProduct {
  id                 Int              @id @default(autoincrement())
  uuid               String           @unique @default(uuid())
  gateVerificationId Int
  inventoryId        Int
  quantity           Float
  quantId            Int?
  locationId         Int?
  gateVerification   GateVerification @relation(fields: [gateVerificationId], references: [id], onDelete: Cascade)
  inventory          Inventory        @relation(fields: [inventoryId], references: [id])
  quant              Quant?           @relation(fields: [quantId], references: [id], onDelete: SetNull)
  location           Location?        @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@index([gateVerificationId])
  @@index([inventoryId])
  @@index([quantId])
  @@index([locationId])
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum CardType {
  IN
  OUT
}

enum VerificationStatus {
  PENDING
  PARTIAL
  COMPLETED
  CANCELED
  VERIFIED
  REJECTED
}

model DocumentReference {
  id                        Int                      @id
  uuid                      String                   @unique @default(uuid())
  warehouseId               Int
  documentNumber            String
  state                     String
  pickingTypeCode           String
  partnerName               String?
  purchaseName              String?
  origin                    String?
  ref_fax                   String?                  @db.VarChar(255)
  sourceLocationName        String?
  destinationLocationName   String?
  scheduledDate             DateTime?
  dateDone                  DateTime?
  driver                    String?
  plateNumber               String?
  totalItems                Int
  totalQuantity             Float
  rawPayload                Json
  lastSyncedAt              DateTime                 @default(now())
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt
  warehouse                 Warehouse                @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  items                     DocumentReferenceItem[]
  references                GateDocumentReference[]
  gateOperations            GateOperation[]

  @@index([warehouseId])
  @@index([uuid])
  @@index([documentNumber])
}

model DocumentReferenceItem {
  id                  Int                      @id
  uuid                String                   @unique @default(uuid())
  documentReferenceId Int
  inventoryId         Int
  productName         String
  uom                 String
  analyticAccountName String?
  quantity            Float
  productQty          Float
  secondaryQuantity   Float?
  secondaryUom        String?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  documentReference   DocumentReference        @relation(fields: [documentReferenceId], references: [id], onDelete: Cascade)
  references          GateDocumentReference[]

  @@index([documentReferenceId])
}

enum OdooSyncStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

model OdooSyncLog {
  id                 Int            @id @default(autoincrement())
  uuid               String         @unique @default(uuid())
  warehouseId        Int
  status             OdooSyncStatus
  startedAt          DateTime       @default(now())
  finishedAt         DateTime?
  totalDocuments     Int            @default(0)
  processedDocuments Int            @default(0)
  errorMessage       String?
  createdBy          String
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  warehouse          Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@index([warehouseId])
  @@index([uuid])
}

model GateDocumentReference {
  id                 Int                   @id @default(autoincrement())
  uuid               String                @unique @default(uuid())
  gateVerificationId Int
  gateItemId         Int
  erpDocumentId      Int
  erpDocumentItemId  Int
  inventoryId        Int
  assignedQuantity   Float
  createdAt          DateTime              @default(now())
  createdBy          String

  gateVerification   GateVerification      @relation(fields: [gateVerificationId], references: [id], onDelete: Cascade)
  gateItem           GateOperationProduct  @relation(fields: [gateItemId], references: [id], onDelete: Cascade)
  erpDocument        DocumentReference     @relation(fields: [erpDocumentId], references: [id], onDelete: Cascade)
  erpDocumentItem    DocumentReferenceItem @relation(fields: [erpDocumentItemId], references: [id], onDelete: Cascade)

  @@index([gateVerificationId])
  @@index([gateItemId])
  @@index([erpDocumentId])
  @@index([erpDocumentItemId])
  @@index([inventoryId])
}

enum StockOpnameStatus {
  DRAFT
  COMPLETED
}

model StockOpname {
  id               Int                   @id @default(autoincrement())
  uuid             String                @unique @default(uuid())
  opnameNumber     String                @unique
  warehouseId      Int
  status           StockOpnameStatus     @default(DRAFT)
  notes            String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  completionDate   DateTime?
  createdById      Int

  warehouse        Warehouse             @relation(fields: [warehouseId], references: [id])
  createdBy        User                  @relation(fields: [createdById], references: [id])
  items            StockOpnameItem[]
  attachments      FileAttachment[]

  @@index([warehouseId])
  @@index([uuid])
  @@index([opnameNumber])
  @@index([status])
}

model StockOpnameItem {
  id              Int                  @id @default(autoincrement())
  uuid            String               @unique @default(uuid())
  stockOpnameId   Int
  inventoryId     Int
  productSku      String
  productName     String
  productUom      String?
  erpStock        Float
  realtimeStock   Float
  difference      Float?

  stockOpname     StockOpname          @relation(fields: [stockOpnameId], references: [id], onDelete: Cascade)
  inventory       Inventory            @relation(fields: [inventoryId], references: [id])
  stacks          StockOpnameStack[]

  @@index([stockOpnameId])
  @@index([inventoryId])
}

model StockOpnameStack {
  id                Int              @id @default(autoincrement())
  uuid              String           @unique @default(uuid())
  stockOpnameItemId Int
  locationId        Int
  locationName      String
  erpQty            Float
  actualQty         Float?
  variance          Float?

  item              StockOpnameItem  @relation(fields: [stockOpnameItemId], references: [id], onDelete: Cascade)
  location          Location         @relation(fields: [locationId], references: [id])

  @@index([stockOpnameItemId])
  @@index([locationId])
}

model DailyStockSnapshot {
  id             Int       @id @default(autoincrement())
  uuid           String    @unique @default(uuid())
  date           DateTime
  warehouseId    Int
  inventoryId    Int
  closingStock   Float

  warehouse      Warehouse @relation(fields: [warehouseId], references: [id])
  inventory      Inventory @relation(fields: [inventoryId], references: [id])

  @@unique([date, warehouseId, inventoryId])
  @@index([date])
  @@index([warehouseId])
  @@index([inventoryId])
}

model DocumentCategory {
  id          Int              @id @default(autoincrement())
  name        String
  description String?
  isActive    Boolean          @default(true) @map("is_active")
  deletedAt   DateTime?        @map("deleted_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  
  manualDocuments ManualDocument[]
  signedDocuments SignedDocument[]

  @@map("document_categories")
}

model SignatureTemplate {
  id          Int              @id @default(autoincrement())
  name        String
  description String?
  pageNumber  Int              @map("page_number")
  posX        Float            @map("pos_x")
  posY        Float            @map("pos_y")
  width       Float            @map("width")
  height      Float            @map("height")
  qrPosX      Float            @map("qr_pos_x")
  qrPosY      Float            @map("qr_pos_y")
  qrWidth     Float            @map("qr_width")
  qrHeight    Float            @map("qr_height")
  isDefault   Boolean          @default(false) @map("is_default")
  isActive    Boolean          @default(true) @map("is_active")
  deletedAt   DateTime?        @map("deleted_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  signedDocuments SignedDocument[]

  @@map("signature_templates")
}

model ManualDocument {
  id          Int              @id @default(autoincrement())
  uuid        String           @unique @default(uuid())
  warehouseId Int?             @map("warehouse_id")
  title       String
  categoryId  Int              @map("category_id")
  description String?
  fileUrl     String           @map("file_url")
  fileKey     String?          @map("file_key")
  uploadedBy  Int              @map("uploaded_by")
  deletedAt   DateTime?        @map("deleted_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  warehouse   Warehouse?       @relation(fields: [warehouseId], references: [id])
  category    DocumentCategory @relation(fields: [categoryId], references: [id])
  uploader    User             @relation(fields: [uploadedBy], references: [id])

  @@map("manual_documents")
  @@index([uuid])
  @@index([warehouseId])
}

model SignedDocument {
  id                  Int               @id @default(autoincrement())
  uuid                String            @unique @default(uuid())
  warehouseId         Int?              @map("warehouse_id")
  sourceType          String            @map("source_type") // ERP or MANUAL
  sourceDocumentId    Int?              @map("source_document_id")
  title               String
  categoryId          Int               @map("category_id")
  signedPdfUrl        String            @map("signed_pdf_url")
  fileKey             String?           @map("file_key")
  fileHash            String?           @map("file_hash")
  originalFileKey     String?           @map("original_file_key")
  verificationToken   String            @unique @map("verification_token")
  signedBy            Int               @map("signed_by")
  signedAt            DateTime          @default(now()) @map("signed_at")
  signatureTemplateId Int?              @map("signature_template_id")
  status              String            @default("VALID") @map("status") // VALID, INVALID, REVOKED
  deletedAt           DateTime?         @map("deleted_at")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  warehouse           Warehouse?        @relation(fields: [warehouseId], references: [id])
  category            DocumentCategory  @relation(fields: [categoryId], references: [id])
  signer              User              @relation(fields: [signedBy], references: [id])
  template            SignatureTemplate? @relation(fields: [signatureTemplateId], references: [id])
  verificationLogs    DocumentVerificationLog[]

  @@map("signed_documents")
  @@index([uuid])
  @@index([warehouseId])
}

model DocumentVerificationLog {
  id                Int            @id @default(autoincrement())
  signedDocumentId  Int            @map("signed_document_id")
  verificationToken String         @map("verification_token")
  ipAddress         String?        @map("ip_address")
  userAgent         String?        @map("user_agent")
  verifiedAt        DateTime       @default(now()) @map("verified_at")

  signedDocument    SignedDocument @relation(fields: [signedDocumentId], references: [id], onDelete: Cascade)

  @@map("document_verification_logs")
}

model SignatureAuditLog {
  id         Int       @id @default(autoincrement())
  userId     Int?      @map("user_id")
  action     String
  documentId Int?      @map("document_id")
  metadata   String?   @map("metadata")
  createdAt  DateTime  @default(now()) @map("created_at")

  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model UserSignature {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  fileUrl   String   @map("file_url")
  fileKey   String   @map("file_key")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_signatures")
}

