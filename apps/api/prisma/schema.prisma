generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                        Int                   @id @default(autoincrement())
  uuid                      String                @unique @default(uuid())
  email                     String                @unique
  password                  String
  name                      String
  isActive                  Boolean               @default(true)
  isFirstLogin              Boolean               @default(true)
  roleId                    Int
  warehouseId               Int?
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt
  auditLogsActor            AuditLog[]            @relation("ActorRelation")
  auditLogsTarget           AuditLog[]            @relation("TargetRelation")
  uploadedFiles             FileAttachment[]
  gateOperationsCreated     GateOperation[]       @relation("GateOpCreator")
  gateVerificationsVerified GateVerification[]    @relation("GateVerifier")
  orders                    Order[]
  passwordResetTokens       PasswordResetToken[]
  sessions                  Session[]
  role                      Role                  @relation(fields: [roleId], references: [id])
  warehouse                 Warehouse?            @relation(fields: [warehouseId], references: [id])
  warehouseAccesses         UserWarehouseAccess[]

  @@index([email])
  @@index([uuid])
}

model Role {
  id          Int              @id @default(autoincrement())
  uuid        String           @unique @default(uuid())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  users       User[]

  @@index([uuid])
  @@index([name])
}

model Permission {
  id         Int              @id @default(autoincrement())
  uuid       String           @unique @default(uuid())
  action     String
  subject    String
  conditions String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  roles      RolePermission[]

  @@index([uuid])
}

model RolePermission {
  roleId       Int
  permissionId Int
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Session {
  id        Int      @id @default(autoincrement())
  uuid      String   @unique @default(uuid())
  userId    Int
  token     String   @unique
  userAgent String?
  ipAddress String?
  isRevoked Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([uuid])
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  uuid      String   @unique @default(uuid())
  userId    Int
  token     String   @unique
  isUsed    Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([uuid])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  uuid      String   @unique @default(uuid())
  actorId   Int?
  targetId  Int?
  action    String
  ipAddress String?
  userAgent String?
  details   String?
  timestamp DateTime @default(now())
  actor     User?    @relation("ActorRelation", fields: [actorId], references: [id])
  target    User?    @relation("TargetRelation", fields: [targetId], references: [id])

  @@index([actorId])
  @@index([targetId])
  @@index([action])
  @@index([uuid])
}

model Warehouse {
  id             Int                   @id @default(autoincrement())
  uuid           String                @unique @default(uuid())
  name           String
  location       String
  capacity       Float
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  gateOperations GateOperation[]
  inventories    Inventory[]
  locations      Location[]
  odooAccount    OdooAccount?
  users          User[]
  userAccesses   UserWarehouseAccess[]

  @@index([uuid])
}

model OdooAccount {
  id                Int       @id @default(autoincrement())
  uuid              String    @unique @default(uuid())
  warehouseId       Int       @unique
  baseUrl           String
  username          String
  encryptedPassword String
  sessionId         String?
  csrfToken         String?
  sessionExpiredAt  DateTime?
  lastLoginAt       DateTime?
  lastRefreshAt     DateTime?
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  lastSyncAt        DateTime?
  lastSyncBy        String?
  lastSyncCount     Int?
  lastSyncError     String?
  lastSyncStatus    String?
  warehouse         Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@index([warehouseId])
  @@index([uuid])
}

model Product {
  id                       Int                       @id @default(autoincrement())
  uuid                     String                    @unique @default(uuid())
  sku                      String                    @unique
  name                     String
  description              String?
  category                 String
  price                    Float
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  uom                      String?
  gateOperationProducts    GateOperationProduct[]
  gateVerificationProducts GateVerificationProduct[]
  inventories              Inventory[]
  orderItems               OrderItem[]
  quants                   Quant[]

  @@index([uuid])
  @@index([sku])
}

model Location {
  id             Int       @id @default(autoincrement())
  uuid           String    @unique @default(uuid())
  odooLocationId Int
  displayName    String
  warehouseId    Int
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  warehouse      Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  quants         Quant[]

  @@unique([warehouseId, odooLocationId])
  @@index([warehouseId])
}

model Quant {
  id                Int      @id @default(autoincrement())
  uuid              String   @unique @default(uuid())
  odooQuantId       Int      @unique
  productId         Int
  locationId        Int
  quantity          Float    @default(0)
  reservedQuantity  Float    @default(0)
  availableQuantity Float    @default(0)
  secondaryUnitQty  Float?   @default(0)
  lotName           String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  location          Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([locationId])
}

model Inventory {
  id          Int       @id @default(autoincrement())
  uuid        String    @unique @default(uuid())
  warehouseId Int
  productId   Int
  quantity    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, productId])
  @@index([uuid])
}

model Order {
  id         Int         @id @default(autoincrement())
  uuid       String      @unique @default(uuid())
  status     OrderStatus @default(PENDING)
  userId     Int
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([userId])
  @@index([uuid])
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  uuid      String  @unique @default(uuid())
  orderId   Int
  productId Int
  quantity  Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([uuid])
}

model UserWarehouseAccess {
  userId      Int       @map("user_id")
  warehouseId Int       @map("warehouse_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@id([userId, warehouseId])
  @@map("user_warehouse_access")
}

model FileAttachment {
  id                     Int               @id @default(autoincrement())
  uuid                   String            @unique @default(uuid())
  filePath               String
  fileName               String
  mimeType               String
  sizeBytes              Int
  uploadedById           Int
  uploadedAt             DateTime          @default(now())
  uploadedBy             User              @relation(fields: [uploadedById], references: [id])
  gateOperationVehicle   GateOperation?
  gateVerificationAttach GateVerification?
}

model GateOperation {
  id              Int                    @id @default(autoincrement())
  uuid            String                 @unique @default(uuid())
  opNumber        String                 @unique
  cardType        CardType
  vehiclePhotoId  Int?                   @unique
  driverName      String
  licensePlate    String
  notes           String?
  status          VerificationStatus     @default(PENDING)
  warehouseId     Int
  createdByUserId Int
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  createdByUser   User                   @relation("GateOpCreator", fields: [createdByUserId], references: [id])
  vehiclePhoto    FileAttachment?        @relation(fields: [vehiclePhotoId], references: [id])
  warehouse       Warehouse              @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  products        GateOperationProduct[]
  verification    GateVerification?

  @@index([uuid])
  @@index([opNumber])
  @@index([warehouseId])
  @@index([status])
}

model GateOperationProduct {
  id              Int           @id @default(autoincrement())
  uuid            String        @unique @default(uuid())
  gateOperationId Int
  productId       Int
  quantity        Float
  gateOperation   GateOperation @relation(fields: [gateOperationId], references: [id], onDelete: Cascade)
  product         Product       @relation(fields: [productId], references: [id])

  @@index([gateOperationId])
  @@index([productId])
}

model GateVerification {
  id              Int                       @id @default(autoincrement())
  uuid            String                    @unique @default(uuid())
  gateOperationId Int                       @unique
  verifiedById    Int
  verifiedAt      DateTime                  @default(now())
  status          VerificationStatus        @default(VERIFIED)
  notes           String?
  attachmentId    Int?                      @unique
  attachment      FileAttachment?           @relation(fields: [attachmentId], references: [id])
  gateOperation   GateOperation             @relation(fields: [gateOperationId], references: [id], onDelete: Cascade)
  verifiedBy      User                      @relation("GateVerifier", fields: [verifiedById], references: [id])
  products        GateVerificationProduct[]

  @@index([uuid])
  @@index([gateOperationId])
}

model GateVerificationProduct {
  id                 Int              @id @default(autoincrement())
  uuid               String           @unique @default(uuid())
  gateVerificationId Int
  productId          Int
  quantity           Float
  gateVerification   GateVerification @relation(fields: [gateVerificationId], references: [id], onDelete: Cascade)
  product            Product          @relation(fields: [productId], references: [id])

  @@index([gateVerificationId])
  @@index([productId])
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum CardType {
  IN
  OUT
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}
