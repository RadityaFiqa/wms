generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                        Int                  @id @default(autoincrement())
  uuid                      String               @unique @default(uuid())
  email                     String               @unique
  password                  String
  name                      String
  isActive                  Boolean              @default(true)
  isFirstLogin              Boolean              @default(true)
  roleId                    Int
  warehouseId               Int?
  createdAt                 DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt                 DateTime             @updatedAt @db.Timestamptz(3)
  auditLogsActor            AuditLog[]           @relation("ActorRelation")
  auditLogsTarget           AuditLog[]           @relation("TargetRelation")
  uploadedFiles             FileAttachment[]
  gateOperationsCreated     GateOperation[]      @relation("GateOpCreator")
  gateOperationsVerified    GateOperation[]      @relation("GateOpVerifier")
  passwordResetTokens       PasswordResetToken[]
  sessions                  Session[]
  stockOpnames              StockOpname[]
  role                      Role                 @relation(fields: [roleId], references: [id])
  warehouse                 Warehouse?           @relation(fields: [warehouseId], references: [id])
  warehouseAccesses         WarehouseAccess[]
  manualDocuments           ManualDocument[]
  signedDocuments           SignedDocument[]
  signatures                UserSignature[]
  stackCardUploadLogs      StackCardUploadLog[]

  @@index([email])
  @@index([uuid])
}

model Role {
  id          Int              @id @default(autoincrement())
  uuid        String           @unique @default(uuid())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)
  permissions RolePermission[]
  users       User[]

  @@index([uuid])
  @@index([name])
}

model Permission {
  id         Int              @id @default(autoincrement())
  uuid       String           @unique @default(uuid())
  action     String
  subject    String
  conditions String?
  createdAt  DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime         @updatedAt @db.Timestamptz(3)
  roles      RolePermission[]

  @@index([uuid])
}

model RolePermission {
  roleId       Int
  permissionId Int
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Session {
  id        Int      @id @default(autoincrement())
  uuid      String   @unique @default(uuid())
  userId    Int
  token     String   @unique
  userAgent String?
  ipAddress String?
  isRevoked Boolean  @default(false)
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([uuid])
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  uuid      String   @unique @default(uuid())
  userId    Int
  token     String   @unique
  isUsed    Boolean  @default(false)
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([uuid])
}

model AuditLog {
  id          Int        @id @default(autoincrement())
  uuid        String     @unique @default(uuid())
  actorId     Int?
  targetId    Int?
  warehouseId Int?
  action      String
  ipAddress   String?
  userAgent   String?
  details     String?
  timestamp   DateTime   @default(now()) @db.Timestamptz(3)
  actor       User?      @relation("ActorRelation", fields: [actorId], references: [id])
  target      User?      @relation("TargetRelation", fields: [targetId], references: [id])
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([targetId])
  @@index([warehouseId])
  @@index([action])
  @@index([uuid])
}

model Warehouse {
  id                  Int                  @id @default(autoincrement())
  uuid                String               @unique @default(uuid())
  code                String               @unique @default("TEMP")
  name                String
  location            String
  capacity            Float
  type                String?
  address             String?
  isActive            Boolean              @default(true)
  odooReference       String?
  createdAt           DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @db.Timestamptz(3)
  dailyStockSnapshots      DailyStockSnapshot[]
  dailyLocationStockSnapshots DailyLocationStockSnapshot[]
  stackCards               StackCard[]
  stackCardUploadLogs      StackCardUploadLog[]
  documentReferences  DocumentReference[]
  gateOperations      GateOperation[]
  inventories         Inventory[]
  locations           Location[]
  odooAccount         OdooAccount?
  odooSyncLogs        OdooSyncLog[]
  stockOpnames        StockOpname[]
  users               User[]
  warehouseAccesses   WarehouseAccess[]
  manualDocuments     ManualDocument[]
  signedDocuments     SignedDocument[]
  auditLogs           AuditLog[]

  @@index([uuid])
  @@index([code])
}

model OdooAccount {
  id                      Int                  @id @default(autoincrement())
  uuid                    String               @unique @default(uuid())
  warehouseId             Int                  @unique
  baseUrl                 String
  username                String
  encryptedPassword       String
  sessionId               String?
  csrfToken               String?
  sessionExpiredAt        DateTime?            @db.Timestamptz(3)
  lastLoginAt             DateTime?            @db.Timestamptz(3)
  lastRefreshAt           DateTime?            @db.Timestamptz(3)
  isActive                Boolean              @default(true)
  createdAt               DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime             @updatedAt @db.Timestamptz(3)
  lastSyncInventoryAt     DateTime?            @db.Timestamptz(3)
  lastSyncInventoryBy     String?
  lastSyncInventoryCount  Int?
  lastSyncInventoryError  String?
  lastSyncInventoryStatus String?
  lastSyncDocumentsAt     DateTime?            @db.Timestamptz(3)
  lastSyncDocumentsBy     String?
  lastSyncDocumentsCount  Int?
  lastSyncDocumentsError  String?
  lastSyncDocumentsStatus String?
  lastDocumentsOffset     Int                  @default(0)
  warehouse               Warehouse            @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@index([warehouseId])
  @@index([uuid])
}

model Location {
  id                       Int                       @id
  uuid                     String                    @unique @default(uuid())
  displayName              String
  warehouseId              Int
  createdAt                DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime                  @updatedAt @db.Timestamptz(3)
  gateOperationProducts    GateOperationProduct[]
  warehouse                Warehouse                 @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  quants                   Quant[]
  stockOpnameStacks        StockOpnameStack[]
  dailyLocationStockSnapshots DailyLocationStockSnapshot[]

  @@index([warehouseId])
}

model Quant {
  id                       Int                       @id
  uuid                     String                    @unique @default(uuid())
  inventoryId              Int
  locationId               Int
  quantity                 Float                     @default(0)
  reservedQuantity         Float                     @default(0)
  availableQuantity        Float                     @default(0)
  secondaryUnitQty         Float?                    @default(0)
  lotName                  String?
  createdAt                DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime                  @updatedAt @db.Timestamptz(3)
  gateOperationProducts    GateOperationProduct[]
  inventory                Inventory                 @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  location                 Location                  @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([inventoryId])
  @@index([locationId])
}

model Inventory {
  id                       Int                       @id
  uuid                     String                    @unique @default(uuid())
  sku                      String
  name                     String
  uom                      String?
  warehouseId              Int                       @default(1)
  createdAt                DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime                  @updatedAt @db.Timestamptz(3)
  dailyStockSnapshots      DailyStockSnapshot[]
  dailyLocationStockSnapshots DailyLocationStockSnapshot[]
  gateOperationProducts    GateOperationProduct[]
  warehouse                Warehouse                 @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  quants                   Quant[]
  stockOpnameItems         StockOpnameItem[]

  @@index([uuid])
  @@index([sku])
  @@index([warehouseId])
}



model WarehouseAccess {
  userId      Int
  warehouseId Int
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@id([userId, warehouseId])
}

model FileAttachment {
  id                 Int               @id @default(autoincrement())
  uuid               String            @unique @default(uuid())
  filePath           String
  fileName           String
  mimeType           String
  sizeBytes          Int
  uploadedById       Int
  uploadedAt         DateTime          @default(now()) @db.Timestamptz(3)
  gateOperationId    Int?
  stockOpnameId      Int?
  gateOperation      GateOperation?    @relation(fields: [gateOperationId], references: [id], onDelete: Cascade)
  stockOpname        StockOpname?      @relation(fields: [stockOpnameId], references: [id], onDelete: Cascade)
  uploadedBy         User              @relation(fields: [uploadedById], references: [id])
}

model GateOperation {
  id                  Int                    @id @default(autoincrement())
  uuid                String                 @unique @default(uuid())
  opNumber            String                 @unique
  cardType            CardType
  driverName          String
  licensePlate        String
  clientPartner       String?
  driverPhone         String?
  notes               String?
  status              VerificationStatus     @default(PENDING)
  warehouseId         Int
  createdByUserId     Int
  verifiedById        Int?
  verifiedAt          DateTime?              @db.Timestamptz(3)
  verificationNotes   String?
  createdAt           DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime               @updatedAt @db.Timestamptz(3)
  documentReferenceId Int?
  attachments         FileAttachment[]
  createdByUser       User                   @relation("GateOpCreator", fields: [createdByUserId], references: [id])
  verifiedBy          User?                  @relation("GateOpVerifier", fields: [verifiedById], references: [id])
  documentReference   DocumentReference?     @relation(fields: [documentReferenceId], references: [id])
  warehouse           Warehouse              @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  products            GateOperationProduct[]

  @@index([uuid])
  @@index([opNumber])
  @@index([warehouseId])
  @@index([status])
}

model GateOperationProduct {
  id              Int                     @id @default(autoincrement())
  uuid            String                  @unique @default(uuid())
  gateOperationId Int
  inventoryId     Int
  quantity        Float
  notes           String?
  quantId         Int?
  locationId      Int?
  gateOperation   GateOperation           @relation(fields: [gateOperationId], references: [id], onDelete: Cascade)
  inventory       Inventory               @relation(fields: [inventoryId], references: [id])
  location        Location?               @relation(fields: [locationId], references: [id])
  quant           Quant?                  @relation(fields: [quantId], references: [id])

  @@index([gateOperationId])
  @@index([inventoryId])
  @@index([quantId])
  @@index([locationId])
}



model DocumentReference {
  id                      Int                     @id
  uuid                    String                  @unique @default(uuid())
  warehouseId             Int
  documentNumber          String
  state                   String
  pickingTypeCode         String
  partnerName             String?
  purchaseName            String?
  origin                  String?
  refFax                  String?                 @db.VarChar(255)
  sourceLocationName      String?
  destinationLocationName String?
  scheduledDate           DateTime? @db.Timestamptz(3)
  dateDone                DateTime? @db.Timestamptz(3)
  driver                  String?
  plateNumber             String?
  totalItems              Int
  totalQuantity           Float
  rawPayload              Json
  lastSyncedAt            DateTime                @default(now()) @db.Timestamptz(3)
  createdAt               DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime                @updatedAt @db.Timestamptz(3)
  warehouse               Warehouse               @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  items                   DocumentReferenceItem[]
  gateOperations          GateOperation[]

  @@index([warehouseId])
  @@index([uuid])
  @@index([documentNumber])
}

model DocumentReferenceItem {
  id                  Int                     @id
  uuid                String                  @unique @default(uuid())
  documentReferenceId Int
  inventoryId         Int
  productName         String
  uom                 String
  analyticAccountName String?
  quantity            Float
  productQty          Float
  secondaryQuantity   Float?
  secondaryUom        String?
  createdAt           DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                @updatedAt @db.Timestamptz(3)
  documentReference   DocumentReference       @relation(fields: [documentReferenceId], references: [id], onDelete: Cascade)

  @@index([documentReferenceId])
}

model OdooSyncLog {
  id                 Int            @id @default(autoincrement())
  uuid               String         @unique @default(uuid())
  warehouseId        Int
  status             OdooSyncStatus
  startedAt          DateTime       @default(now()) @db.Timestamptz(3)
  finishedAt         DateTime?      @db.Timestamptz(3)
  totalDocuments     Int            @default(0)
  processedDocuments Int            @default(0)
  errorMessage       String?
  createdBy          String
  createdAt          DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime       @updatedAt @db.Timestamptz(3)
  warehouse          Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@index([warehouseId])
  @@index([uuid])
}



model StockOpname {
  id             Int               @id @default(autoincrement())
  uuid           String            @unique @default(uuid())
  opnameNumber   String            @unique
  warehouseId    Int
  status         StockOpnameStatus @default(DRAFT)
  notes          String?
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(3)
  completionDate DateTime?         @db.Timestamptz(3)
  createdById    Int
  attachments    FileAttachment[]
  createdBy      User              @relation(fields: [createdById], references: [id])
  warehouse      Warehouse         @relation(fields: [warehouseId], references: [id])
  items          StockOpnameItem[]

  @@index([warehouseId])
  @@index([uuid])
  @@index([opnameNumber])
  @@index([status])
}

model StockOpnameItem {
  id            Int                @id @default(autoincrement())
  uuid          String             @unique @default(uuid())
  stockOpnameId Int
  inventoryId   Int
  productSku    String
  productName   String
  productUom    String?
  erpStock      Float
  realtimeStock Float
  difference    Float?
  inventory     Inventory          @relation(fields: [inventoryId], references: [id])
  stockOpname   StockOpname        @relation(fields: [stockOpnameId], references: [id], onDelete: Cascade)
  stacks        StockOpnameStack[]

  @@index([stockOpnameId])
  @@index([inventoryId])
}

model StockOpnameStack {
  id                Int             @id @default(autoincrement())
  uuid              String          @unique @default(uuid())
  stockOpnameItemId Int
  locationId        Int
  locationName      String
  erpQty            Float
  actualQty         Float?
  variance          Float?
  location          Location        @relation(fields: [locationId], references: [id])
  item              StockOpnameItem @relation(fields: [stockOpnameItemId], references: [id], onDelete: Cascade)

  @@index([stockOpnameItemId])
  @@index([locationId])
}

model DailyStockSnapshot {
  id           Int       @id @default(autoincrement())
  uuid         String    @unique @default(uuid())
  date         DateTime @db.Timestamptz(3)
  warehouseId  Int
  inventoryId  Int
  closingStock Float
  inventory    Inventory @relation(fields: [inventoryId], references: [id])
  warehouse    Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([date, warehouseId, inventoryId])
  @@index([date])
  @@index([warehouseId])
  @@index([inventoryId])
}

model DailyLocationStockSnapshot {
  id           Int       @id @default(autoincrement())
  uuid         String    @unique @default(uuid())
  date         DateTime  @db.Timestamptz(3)
  warehouseId  Int
  locationId   Int
  inventoryId  Int
  openingStock   Float     @default(0)
  erpStock       Float     @default(0)
  pendingInQty   Float     @default(0)
  pendingOutQty  Float     @default(0)
  totalIn        Float     @default(0)
  totalOut       Float     @default(0)
  closingStock   Float     @default(0)
  stack          String?
  gateOpRefs     String?
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  location     Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  inventory    Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  warehouse    Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([date, warehouseId, locationId, inventoryId])
  @@index([date])
  @@index([warehouseId])
  @@index([locationId])
  @@index([inventoryId])
}

model DocumentCategory {
  id              Int              @id @default(autoincrement())
  name            String
  description     String?
  isActive        Boolean          @default(true)
  deletedAt       DateTime?        @db.Timestamptz(3)
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(3)
  manualDocuments ManualDocument[]
  signedDocuments SignedDocument[]

  @@map("DocumentCategory")
}

model SignatureTemplate {
  id              Int              @id @default(autoincrement())
  name            String
  description     String?
  pageNumber      Int
  posX            Float
  posY            Float
  width           Float
  height          Float
  qrPosX          Float
  qrPosY          Float
  qrWidth         Float
  qrHeight        Float
  isDefault       Boolean          @default(false)
  isActive        Boolean          @default(true)
  deletedAt       DateTime?        @db.Timestamptz(3)
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(3)
  signedDocuments SignedDocument[]

  @@map("SignatureTemplate")
}

model ManualDocument {
  id          Int              @id @default(autoincrement())
  uuid        String           @unique @default(uuid())
  warehouseId Int?
  title       String
  categoryId  Int
  description String?
  fileUrl     String
  fileKey     String?
  uploadedBy  Int
  deletedAt   DateTime?        @db.Timestamptz(3)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)
  category    DocumentCategory @relation(fields: [categoryId], references: [id])
  uploader    User             @relation(fields: [uploadedBy], references: [id])
  warehouse   Warehouse?       @relation(fields: [warehouseId], references: [id])

  @@index([uuid])
  @@index([warehouseId])
  @@map("ManualDocument")
}

model SignedDocument {
  id                  Int                       @id @default(autoincrement())
  uuid                String                    @unique @default(uuid())
  warehouseId         Int?
  sourceType          String
  sourceDocumentId    Int?
  title               String
  categoryId          Int
  signedPdfUrl        String
  fileKey             String?
  fileHash            String?
  originalFileKey     String?
  verificationToken   String                    @unique
  signedBy            Int
  signedAt            DateTime                  @default(now()) @db.Timestamptz(3)
  signatureTemplateId Int?
  status              String                    @default("VALID")
  deletedAt           DateTime?                 @db.Timestamptz(3)
  createdAt           DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                  @updatedAt @db.Timestamptz(3)
  verificationLogs    DocumentVerificationLog[]
  category            DocumentCategory          @relation(fields: [categoryId], references: [id])
  template            SignatureTemplate?        @relation(fields: [signatureTemplateId], references: [id])
  signer              User                      @relation(fields: [signedBy], references: [id])
  warehouse           Warehouse?                @relation(fields: [warehouseId], references: [id])

  @@index([uuid])
  @@index([warehouseId])
  @@map("SignedDocument")
}

model DocumentVerificationLog {
  id                Int            @id @default(autoincrement())
  signedDocumentId  Int
  verificationToken String
  ipAddress         String?
  userAgent         String?
  verifiedAt        DateTime       @default(now()) @db.Timestamptz(3)
  signedDocument    SignedDocument @relation(fields: [signedDocumentId], references: [id], onDelete: Cascade)

  @@map("DocumentVerificationLog")
}



model UserSignature {
  id        Int      @id @default(autoincrement())
  userId    Int
  fileUrl   String
  fileKey   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("UserSignature")
}

model StackCard {
  id            Int      @id @default(autoincrement())
  uuid          String   @unique @default(uuid())
  warehouseId   Int
  productName   String
  sku           String
  lot           String
  shelfLife     Int      // in months
  expiredDate   DateTime? @db.Timestamptz(3)
  placementDate DateTime @db.Timestamptz(3)
  locationName  String
  quantity      Float
  quantum       Float
  uom           String
  spraying      String?
  fumigasi      String?
  fogging       String?
  keterangan    String?
  isPublished   Boolean  @default(false)
  snapshotDate  DateTime @db.Timestamptz(3)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  warehouse     Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@index([warehouseId])
  @@index([snapshotDate])
  @@index([locationName])
  @@index([sku])
  @@index([lot])
  @@index([uuid])
  @@map("StackCard")
}

model StackCardUploadLog {
  id            Int      @id @default(autoincrement())
  uuid          String   @unique @default(uuid())
  warehouseId   Int
  snapshotDate  DateTime @db.Timestamptz(3)
  filename      String
  locationName  String
  rowCount      Int
  actionType    String   // "REPLACE" | "APPEND"
  uploadedById  Int
  uploadedAt    DateTime @default(now()) @db.Timestamptz(3)

  warehouse     Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  uploadedBy    User      @relation(fields: [uploadedById], references: [id])

  @@index([warehouseId])
  @@index([snapshotDate])
  @@index([uuid])
  @@map("StackCardUploadLog")
}

enum CardType {
  IN
  OUT
}

enum VerificationStatus {
  PENDING
  CANCELED
  VERIFIED
  REJECTED
}

enum OdooSyncStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

enum StockOpnameStatus {
  DRAFT
  COMPLETED
}
